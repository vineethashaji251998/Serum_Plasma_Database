# 30. FINAL SUMMARY
# =============================================================================

cat("\n")
cat("============================================================\n")
cat("              ANALYSIS COMPLETED\n")
cat("============================================================\n\n")

cat(
  "Input UniProt IDs       : ",
  length(uniprot_ids),
  "\n"
)

cat(
  "Mapped UniProt IDs      : ",
