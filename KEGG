# ============================================================
# 7. FUNCTION:
#    SYMBOL -> ENTREZID
# ============================================================

convert_symbols <- function(symbols) {
  
  symbols <- as.character(symbols)
  
  symbols <- trimws(symbols)
  
  symbols <- symbols[
    !is.na(symbols) &
      symbols != ""
  ]
  
  symbols <- unique(symbols)
  
  
  if (length(symbols) == 0) {
    
    return(
      data.frame(
        SYMBOL = character(),
        ENTREZID = character(),
        stringsAsFactors = FALSE
      )
    )
  }
  
  
  converted <- tryCatch(
    
    {
      
      bitr(
        symbols,
        fromType = "SYMBOL",
        toType = "ENTREZID",
        OrgDb = org.Hs.eg.db
      )
      
    },
    
    error = function(e) {
      
      message(
        "SYMBOL conversion error: ",
        conditionMessage(e)
      )
      
      return(
        data.frame()
      )
    }
  )
  
  
  if (nrow(converted) == 0) {
    
    return(
      data.frame()
    )
  }
  
  
  # Remove duplicated Entrez IDs
  
  converted <- converted[
    !duplicated(
      converted$ENTREZID
    ),
  ]
  
  
  return(converted)
}


# ============================================================
# 8. FUNCTION:
#    RUN KEGG ENRICHMENT
# ============================================================

run_kegg <- function(
    genes,
    background_genes
) {
  
  # --------------------------------------------------------
  # Clean target genes
  # --------------------------------------------------------
  
  genes <- as.character(genes)
  
  genes <- trimws(genes)
  
  genes <- genes[
    !is.na(genes) &
      genes != ""
  ]
  
  genes <- unique(genes)
  
  
  # --------------------------------------------------------
  # Clean background genes
  # --------------------------------------------------------
  
  background_genes <- as.character(
    background_genes
  )
  
  background_genes <- trimws(
    background_genes
  )
  
  background_genes <- background_genes[
    !is.na(background_genes) &
      background_genes != ""
  ]
  
  background_genes <- unique(
    background_genes
  )
  
  
  # --------------------------------------------------------
  # Nothing to analyze
  # --------------------------------------------------------
  
  if (length(genes) == 0) {
    
    return(
      list(
        result = data.frame(),
        conversion = data.frame()
      )
    )
  }
  
  
  # --------------------------------------------------------
  # Convert target genes
  # --------------------------------------------------------
  
  target_conversion <-
    convert_symbols(
      genes
    )
  
  
  if (nrow(target_conversion) == 0) {
    
    return(
      list(
        result = data.frame(),
        conversion = data.frame()
      )
    )
  }
  
  
  # --------------------------------------------------------
  # Convert background genes
  # --------------------------------------------------------
  
  background_conversion <-
    convert_symbols(
      background_genes
    )
  
  
  if (nrow(background_conversion) == 0) {
    
    return(
      list(
        result = data.frame(),
        conversion = target_conversion
      )
    )
  }
  
  
  # --------------------------------------------------------
  # Get Entrez IDs
  # --------------------------------------------------------
  
  target_entrez <- unique(
    target_conversion$ENTREZID
  )
  
  background_entrez <- unique(
    background_conversion$ENTREZID
  )
  
  
  # --------------------------------------------------------
  # Keep only target genes present in background
  # --------------------------------------------------------
  
  target_entrez <- intersect(
    target_entrez,
    background_entrez
  )
  
  
  if (length(target_entrez) == 0) {
    
    return(
      list(
        result = data.frame(),
        conversion = target_conversion
      )
    )
  }
  
  
  # --------------------------------------------------------
  # KEGG enrichment
  # --------------------------------------------------------
  
  kegg <- tryCatch(
    
    {
      
      enrichKEGG(
        
        gene = target_entrez,
        
        universe = background_entrez,
        
        organism = "hsa",
        
        keyType = "ncbi-geneid",
        
        pAdjustMethod = "BH",
        
        pvalueCutoff = 1,
        
        qvalueCutoff = 1
      )
      
    },
    
    error = function(e) {
      
      message(
        "KEGG error: ",
        conditionMessage(e)
      )
      
      return(NULL)
    }
  )
  
  
  if (is.null(kegg)) {
    
    return(
      list(
        result = data.frame(),
        conversion = target_conversion
      )
    )
  }
  
  
  kegg_df <- as.data.frame(
    kegg
  )
  
  
  if (nrow(kegg_df) == 0) {
    
    return(
      list(
        result = data.frame(),
        conversion = target_conversion
      )
    )
  }
  
  
  # --------------------------------------------------------
  # Convert KEGG Entrez IDs back to SYMBOL
  # --------------------------------------------------------
  
  kegg_df$geneID_SYMBOL <- sapply(
    
    kegg_df$geneID,
    
    function(x) {
      
      ids <- unlist(
        strsplit(
          x,
          "/"
        )
      )
      
      
      symbols <- target_conversion$SYMBOL[
        match(
          ids,
          target_conversion$ENTREZID
        )
      ]
      
      
      symbols <- symbols[
        !is.na(symbols)
      ]
      
      
      paste(
        unique(symbols),
        collapse = ";"
      )
    }
  )
  
  
  # --------------------------------------------------------
  # Count genes
  # --------------------------------------------------------
  
  kegg_df$Gene_Count <- sapply(
    
    kegg_df$geneID_SYMBOL,
    
    function(x) {
      
      if (
        is.na(x) ||
        x == ""
      ) {
        
        return(0)
      }
      
      
      length(
        unique(
          unlist(
            strsplit(
              x,
              ";"
            )
          )
        )
      )
    }
  )
  
  
  return(
    list(
      result = kegg_df,
      conversion = target_conversion
    )
  )
}


# ============================================================
# 9. FUNCTION:
#    PROCESS ONE VIRUS
# ============================================================

process_one_virus <- function(
    virus_data,
    virus_name
) {
  
  message("")
  message(
    "============================================"
  )
  message(
    "Processing virus: ",
    virus_name
  )
  message(
    "============================================"
  )
  
  
  # --------------------------------------------------------
  # Clean SYMBOL
  # --------------------------------------------------------
  
  virus_data[["SYMBOL"]] <- trimws(
    as.character(
      virus_data[["SYMBOL"]]
    )
  )
  
  
  # --------------------------------------------------------
  # Get regulation column
  # --------------------------------------------------------
  
  regulation <- toupper(
    trimws(
      as.character(
        virus_data[["Differential_regulation_Discovery_Cohort"]]
      )
    )
  )
  
  
  # --------------------------------------------------------
  # Normalize regulation
  #
  # Up / UP / up       -> Up
  # Down / DOWN / down -> Down
  # --------------------------------------------------------
  
  virus_data$Regulation <- ifelse(
    
    grepl(
      "^UP",
      regulation
    ),
    
    "Up",
    
    ifelse(
      
      grepl(
        "^DOWN",
        regulation
      ),
      
      "Down",
      
      NA_character_
    )
  )
  
  
  # --------------------------------------------------------
  # Remove invalid rows
  # --------------------------------------------------------
  
  virus_data <- virus_data[
    !is.na(
      virus_data$Regulation
    ) &
      !is.na(
        virus_data$SYMBOL
      ) &
      virus_data$SYMBOL != "",
  ]
  
  
  # --------------------------------------------------------
  # Get UP proteins
  # --------------------------------------------------------
  
  up_genes <- unique(
    virus_data$SYMBOL[
      virus_data$Regulation == "Up"
    ]
  )
  
  
  # --------------------------------------------------------
  # Get DOWN proteins
  # --------------------------------------------------------
  
  down_genes <- unique(
    virus_data$SYMBOL[
      virus_data$Regulation == "Down"
    ]
  )
  
  
  # --------------------------------------------------------
  # Background
  #
  # All observed proteins for this virus
  # --------------------------------------------------------
  
  background_genes <- unique(
    virus_data$SYMBOL
  )
  
  
  message(
    "Unique UP proteins: ",
    length(up_genes)
  )
  
  message(
    "Unique DOWN proteins: ",
    length(down_genes)
  )
  
  message(
    "Background proteins: ",
    length(background_genes)
  )
  
  
  # ========================================================
  # UP KEGG
  # ========================================================
  
  up_result <- run_kegg(
    
    genes =
      up_genes,
    
    background_genes =
      background_genes
  )
  
  
  up_kegg <- up_result$result
  
  
  if (nrow(up_kegg) > 0) {
    
    up_kegg$Disease_Virus <-
      virus_name
    
    up_kegg$Regulation <-
      "Up"
  }
  
  
  # ========================================================
  # DOWN KEGG
  # ========================================================
  
  down_result <- run_kegg(
    
    genes =
      down_genes,
    
    background_genes =
      background_genes
  )
  
  
  down_kegg <- down_result$result
  
  
  if (nrow(down_kegg) > 0) {
    
    down_kegg$Disease_Virus <-
      virus_name
    
    down_kegg$Regulation <-
      "Down"
  }
  
  
  # ========================================================
  # COMBINE UP + DOWN
  # ========================================================
  
  combined <- rbind(
    up_kegg,
    down_kegg
  )
  
  
  # --------------------------------------------------------
  # If no pathways
  # --------------------------------------------------------
  
  if (nrow(combined) == 0) {
    
    message(
      "No KEGG pathways returned for: ",
      virus_name
    )
    
    
    return(
      list(
        summary = data.frame(),
        up = up_kegg,
        down = down_kegg,
        conversion = rbind(
          up_result$conversion,
          down_result$conversion
        )
      )
    )
  }
  
  
  # ========================================================
  # CREATE PATHWAY SUMMARY
  # ========================================================
  
  pathway_ids <- unique(
    combined$ID
  )
  
  
  summary_list <- list()
  
  
  for (
    pathway_id in pathway_ids
  ) {
    
    
    pathway_data <- combined[
      combined$ID == pathway_id,
    ]
    
    
    pathway_name <- unique(
      pathway_data$Description
    )[1]
    
    
    # ----------------------------------------------------
    # UP
    # ----------------------------------------------------
    
    up_data <- pathway_data[
      pathway_data$Regulation == "Up",
    ]
    
    
    significant_up <- up_data[
      !is.na(up_data$p.adjust) &
        up_data$p.adjust < PADJ_CUTOFF,
    ]
    
    
    up_sig <- nrow(
      significant_up
    ) > 0
    
    
    # ----------------------------------------------------
    # DOWN
    # ----------------------------------------------------
    
    down_data <- pathway_data[
      pathway_data$Regulation == "Down",
    ]
    
    
    significant_down <- down_data[
      !is.na(down_data$p.adjust) &
        down_data$p.adjust < PADJ_CUTOFF,
    ]
    
    
    down_sig <- nrow(
      significant_down
    ) > 0
    
    
    # ----------------------------------------------------
    # Classify
    # ----------------------------------------------------
    
    if (
      up_sig &&
      down_sig
    ) {
      
      regulation_class <- "Both"
      
    } else if (
      up_sig
    ) {
      
      regulation_class <- "Up"
      
    } else if (
      down_sig
    ) {
      
      regulation_class <- "Down"
      
    } else {
      
      next
    }
    
    
    # ====================================================
    # UP DETAILS
    # ====================================================
    
    if (up_sig) {
      
      best_up <- significant_up[
        which.min(
          significant_up$p.adjust
        ),
      ]
      
      
      up_genes_pathway <-
        best_up$geneID_SYMBOL
      
      up_pvalue <-
        best_up$pvalue
      
      up_padjust <-
        best_up$p.adjust
      
      up_count <-
        best_up$Gene_Count
      
    } else {
      
      up_genes_pathway <- ""
      
      up_pvalue <- NA
      
      up_padjust <- NA
      
      up_count <- 0
    }
    
    
    # ====================================================
    # DOWN DETAILS
    # ====================================================
    
    if (down_sig) {
      
      best_down <- significant_down[
        which.min(
          significant_down$p.adjust
        ),
      ]
      
      
      down_genes_pathway <-
        best_down$geneID_SYMBOL
      
      down_pvalue <-
        best_down$pvalue
      
      down_padjust <-
        best_down$p.adjust
      
      down_count <-
        best_down$Gene_Count
      
    } else {
      
      down_genes_pathway <- ""
      
      down_pvalue <- NA
      
      down_padjust <- NA
      
      down_count <- 0
    }
    
    
    # ====================================================
    # ADD TO SUMMARY LIST
    # ====================================================
    
    summary_list[[length(summary_list) + 1]] <- data.frame(
      
      Disease_Virus =
        virus_name,
      
      KEGG_ID =
        pathway_id,
      
      Pathway =
        pathway_name,
      
      Regulation =
        regulation_class,
      
      Up_Gene_Count =
        up_count,
      
      Down_Gene_Count =
        down_count,
      
      Up_Genes =
        up_genes_pathway,
      
      Down_Genes =
        down_genes_pathway,
      
      Up_pvalue =
        up_pvalue,
      
      Up_p_adjust =
        up_padjust,
      
      Down_pvalue =
        down_pvalue,
      
      Down_p_adjust =
        down_padjust,
      
      stringsAsFactors =
        FALSE
    )
  }
  
  
  # ========================================================
  # COMBINE SUMMARY
  # ========================================================
  
  if (length(summary_list) > 0) {
    
    pathway_summary <- do.call(
      rbind,
      summary_list
    )
    
  } else {
    
    pathway_summary <- data.frame()
  }
  
  
  # ========================================================
  # RETURN
  # ========================================================
  
  return(
    list(
      
      summary =
        pathway_summary,
      
      up =
        up_kegg,
      
      down =
        down_kegg,
      
      conversion =
        rbind(
          up_result$conversion,
          down_result$conversion
        )
    )
  )
}


# ============================================================
# 10. PROCESS PLASMA / SERUM
# ============================================================

process_dataset <- function(
    
  input_file,
  
  sheet_name,
  
  output_dir,
  
  dataset_name
  
) {
  
  
  message("")
  message(
    "############################################"
  )
  message(
    "DATASET: ",
    dataset_name
  )
  message(
    "############################################"
  )
  
  
  # ========================================================
  # READ EXCEL
  # ========================================================
  
  data <- read.xlsx(
    
    input_file,
    
    sheet =
      sheet_name
  )
  
  
  # ========================================================
  # CLEAN COLUMN NAMES
  # ========================================================
  
  names(data) <- trimws(
    names(data)
  )
  
  
  message("")
  message(
    "Columns found:"
  )
  
  print(
    names(data)
  )
  
  
  # ========================================================
  # CHECK REQUIRED COLUMNS
  # ========================================================
  
  required_columns <- c(
    
    "SYMBOL",
    
    "Disease_(Virus)",
    
    "Differential_regulation_Discovery_Cohort"
  )
  
  
  missing_columns <- setdiff(
    
    required_columns,
    
    names(data)
  )
  
  
  if (
    length(missing_columns) > 0
  ) {
    
    stop(
      paste(
        "Missing required columns:",
        paste(
          missing_columns,
          collapse = ", "
        )
      )
    )
  }
  
  
  # ========================================================
  # REGULATION VALUES
  # ========================================================
  
  message("")
  message(
    "Original regulation values:"
  )
  
  print(
    table(
      data[["Differential_regulation_Discovery_Cohort"]],
      useNA = "ifany"
    )
  )
  
  
  # ========================================================
  # VIRUS VALUES
  # ========================================================
  
  virus_values <- trimws(
    as.character(
      data[["Disease_(Virus)"]]
    )
  )
  
  
  viruses <- unique(
    virus_values
  )
  
  
  viruses <- viruses[
    !is.na(viruses) &
      viruses != ""
  ]
  
  
  message("")
  message(
    "Disease/Virus values:"
  )
  
  print(
    viruses
  )
  
  
  message("")
  message(
    "Number of viruses: ",
    length(viruses)
  )
  
  
  # ========================================================
  # CREATE RESULT LISTS
  # ========================================================
  
  all_summary <- list()
  
  all_up <- list()
  
  all_down <- list()
  
  all_conversion <- list()
  
  
  # ========================================================
  # PROCESS EACH VIRUS
  # ========================================================
  
  for (
    virus in viruses
  ) {
    
    
    virus_data <- data[
      virus_values == virus,
    ]
    
    
    result <- process_one_virus(
      
      virus_data,
      
      virus
    )
    
    
    # ----------------------------------------------------
    # Summary
    # ----------------------------------------------------
    
    if (
      nrow(result$summary) > 0
    ) {
      
      all_summary[[length(all_summary) + 1]] <- result$summary
    }
    
    
    # ----------------------------------------------------
    # UP
    # ----------------------------------------------------
    
    if (
      nrow(result$up) > 0
    ) {
      
      all_up[[length(all_up) + 1]] <- result$up
    }
    
    
    # ----------------------------------------------------
    # DOWN
    # ----------------------------------------------------
    
    if (
      nrow(result$down) > 0
    ) {
      
      all_down[[length(all_down) + 1]] <- result$down
    }
    
    
    # ----------------------------------------------------
    # Gene conversion
    # ----------------------------------------------------
    
    if (
      nrow(result$conversion) > 0
    ) {
      
      all_conversion[[length(all_conversion) + 1]] <- result$conversion
    }
  }
  
  
  # ========================================================
  # COMBINE ALL RESULTS
  # ========================================================
  
  if (length(all_summary) > 0) {
    
    final_summary <- do.call(
      rbind,
      all_summary
    )
    
  } else {
    
    final_summary <- data.frame()
  }
  
  
  if (length(all_up) > 0) {
    
    final_up <- do.call(
      rbind,
      all_up
    )
    
  } else {
    
    final_up <- data.frame()
  }
  
  
  if (length(all_down) > 0) {
    
    final_down <- do.call(
      rbind,
      all_down
    )
    
  } else {
    
    final_down <- data.frame()
  }
  
  
  if (length(all_conversion) > 0) {
    
    final_conversion <- do.call(
      rbind,
      all_conversion
    )
    
  } else {
    
    final_conversion <- data.frame()
  }
  
  
  # Remove duplicate conversion rows
  
  if (
    nrow(final_conversion) > 0
  ) {
    
    final_conversion <- unique(
      final_conversion
    )
  }
  
  
  # ========================================================
  # OUTPUT FILE
  # ========================================================
  
  output_file <- file.path(
    
    output_dir,
    
    paste0(
      dataset_name,
      "_KEGG_Enrichment.xlsx"
    )
  )
  
  
  # ========================================================
  # CREATE WORKBOOK
  # ========================================================
  
  wb <- createWorkbook()
  
  
  # ========================================================
  # SHEET 1:
  # PATHWAY SUMMARY
  # ========================================================
  
  addWorksheet(
    wb,
    "Pathway_Summary"
  )
  
  
  if (
    nrow(final_summary) > 0
  ) {
    
    writeData(
      wb,
      "Pathway_Summary",
      final_summary
    )
    
  } else {
    
    writeData(
      wb,
      "Pathway_Summary",
      data.frame(
        Message =
          "No significant KEGG pathways found"
      )
    )
  }
  
  
  # ========================================================
  # SHEET 2:
  # UP ENRICHMENT
  # ========================================================
  
  addWorksheet(
    wb,
    "Up_Enrichment"
  )
  
  
  if (
    nrow(final_up) > 0
  ) {
    
    writeData(
      wb,
      "Up_Enrichment",
      final_up
    )
    
  } else {
    
    writeData(
      wb,
      "Up_Enrichment",
      data.frame(
        Message =
          "No KEGG results for Up proteins"
      )
    )
  }
  
  
  # ========================================================
  # SHEET 3:
  # DOWN ENRICHMENT
  # ========================================================
  
  addWorksheet(
    wb,
    "Down_Enrichment"
  )
  
  
  if (
    nrow(final_down) > 0
  ) {
    
    writeData(
      wb,
      "Down_Enrichment",
      final_down
    )
    
  } else {
    
    writeData(
      wb,
      "Down_Enrichment",
      data.frame(
        Message =
          "No KEGG results for Down proteins"
      )
    )
  }
  
  
  # ========================================================
  # SHEET 4:
  # GENE CONVERSION
  # ========================================================
  
  addWorksheet(
    wb,
    "Gene_Conversion"
  )
  
  
  if (
    nrow(final_conversion) > 0
  ) {
    
    writeData(
      wb,
      "Gene_Conversion",
      final_conversion
    )
    
  } else {
    
    writeData(
      wb,
      "Gene_Conversion",
      data.frame(
        Message =
          "No genes could be converted"
      )
    )
  }
  
  
  # ========================================================
  # SAVE EXCEL
  # ========================================================
  
  saveWorkbook(
    
    wb,
    
    output_file,
    
    overwrite =
      TRUE
  )
  
  
  # ========================================================
  # REPORT
  # ========================================================
  
  message("")
  message(
