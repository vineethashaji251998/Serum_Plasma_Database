  "\n"
)

cat(
  "Unmapped UniProt IDs    : ",
  length(unmapped_ids),
  "\n"
)

cat(
  "Unique Entrez IDs       : ",
  length(entrez_ids),
  "\n"
)

cat(
  "KEGG pathways           : ",
  nrow(kegg_df),
  "\n"
)

cat(
  "Significant pathways    : ",
  nrow(significant_kegg),
  "\n\n"
)

cat(
  "Main output             : ",
  OUTPUT_FILE,
  "\n"
)

cat(
  "Excel output            : ",
