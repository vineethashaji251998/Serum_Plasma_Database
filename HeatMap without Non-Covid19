check_output_file <- function(file_path) {

  if (!file.exists(file_path)) {
    stop(
      paste0(
        "\nERROR: Heatmap file was NOT created:\n",
        file_path
      )
    )
  }

  if (file.info(file_path)$size == 0) {
    stop(
      paste0(
        "\nERROR: Heatmap file is empty:\n",
        file_path
      )
    )
  }

  cat(
    "Created: ",
    normalizePath(
      file_path,
      winslash = "/",
      mustWork = FALSE
    ),
    "\n",
    sep = ""
  )
}


